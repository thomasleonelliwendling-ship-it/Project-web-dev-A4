# ── Base de donnees ──────────────────────────────────────────────
# Option A : MongoDB Atlas (cloud, aucune installation requise)
# Creez un cluster gratuit sur https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=LWTrade

# Option B : MongoDB local via Docker (voir docker-compose.yml a la racine)
# MONGODB_URI=mongodb://stan:stan@localhost:35115/myapp?authSource=myapp

# ── Serveur ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT / Authentification ───────────────────────────────────────
JWT_SECRET=change-me-with-a-random-string
JWT_COOKIE_NAME=token

# ── URL du frontend (pour les emails de verification) ────────────
APP_BASE_URL=http://localhost:3000

# ── SMTP (optionnel — si absent, les emails sont loggues en console)
# Exemple avec Gmail : activer "Mot de passe d'application" dans les parametres Google
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe-application
# MAIL_FROM="L-W Trade <votre-email@gmail.com>"
